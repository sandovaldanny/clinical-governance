# Backend (desarrollo local sin Docker). Copiar a backend/.env
DATABASE_URL=postgresql+psycopg://aegis:aegis@localhost:5432/aegis
JWT_SECRET=change-me-in-every-environment
JWT_EXPIRE_MINUTES=60
ENV=local

# Bypass de autenticación — SOLO desarrollo local, nunca en staging/producción
AUTH_DISABLED=false

# System Administrator del seed (demo: entra como `admin` / `admin`, sin cambio forzado)
SEED_ADMIN_EMAIL=admin@alkalma.health
SEED_ADMIN_TEMP_PASSWORD=admin
